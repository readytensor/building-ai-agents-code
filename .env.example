# ----------------------------------------------------------------------
# The episode agents' config (the teaching code, not the eval).
# ----------------------------------------------------------------------
# Default: GLM 5.2 via OpenRouter, the model the series runs on.
# Switch providers by changing LLM_BASE_URL + LLM_AGENT_MODEL - the matching key
# below is selected automatically (see make_client), so you never move keys around.

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_AGENT_MODEL=z-ai/glm-5.2

# Optional response cap; the agent loops don't set it.
LLM_MAX_TOKENS=4096

# --- Other provider examples (change LLM_BASE_URL; the matching key is auto-selected) ---
# OpenAI:        unset LLM_BASE_URL,  LLM_AGENT_MODEL=gpt-5-mini
# Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1
# Together:      LLM_BASE_URL=https://api.together.xyz/v1
# DeepSeek:      LLM_BASE_URL=https://api.deepseek.com/v1
# Anthropic:     LLM_BASE_URL=https://api.anthropic.com/v1/   LLM_AGENT_MODEL=claude-sonnet-4-6
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1   (model slugs are provider/model, e.g. anthropic/claude-sonnet-4.6; see openrouter.ai/models)

# --- Provider keys: fill in the one(s) you use. make_client() picks by provider. ---
# OPENAI_API_KEY also covers Together / DeepSeek (OpenAI-compatible endpoints).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
MANUS_API_KEY=

# ======================================================================
# EVAL HARNESS (eval/ runs only; the episodes keep using LLM_* above).
# If unset, eval falls back to LLM_BASE_URL / LLM_AGENT_MODEL.
# ======================================================================
EVAL_LLM_BASE_URL=https://openrouter.ai/api/v1
EVAL_LLM_AGENT_MODEL=z-ai/glm-5.2
