# Local-only working files — not part of the public repo.
tmp/
README-INTERNAL.md

# Coding agents
.claude/
CLAUDE.md
Codex.md

# Alternative sandbox directories (scratch/experiment scripts use these)
episodes/*/_sandbox*/

# Underscore-prefixed directories and scripts under episodes/ are local
# scratch/experiments — same convention for both. The negation re-includes
# dunder modules (__init__.py, __main__.py), which also start with "_" and
# MUST ship — without it the md2html package can't be imported.
episodes/_*/
episodes/**/_*.py
!episodes/**/__*.py

# Stray run logs inside episodes/<N-name>/ are run byproducts.
episodes/**/run*.log

# --- Code artifacts ---
# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
# Virtualenvs
.venv/
venv/
env/
# Environment files — .env.example IS committed; only real .env files are ignored
.env
.env.local
# Agent working dirs + per-run artifacts (recreated by agent.py / capture.py each run)
episodes/*/sandbox/
episodes/*/logs/
episodes/*/tool_calls.jsonl
episodes/*/messages.jsonl
logs/
# Rendered demo output from the examples/ tool (e.g. examples/about-the-series.html).
# Generated by running md2html on the sample doc; the source .md is committed, the
# .html is a build artifact. Scoped to the top of examples/ so it does NOT touch the
# committed test fixtures under examples/md2html/tests/fixtures/*.html.
examples/*.html
# Eval harness generated results (scoreboard + per-batch artifacts).
# Note: eval/fixtures/ is NOT ignored -- it holds the md2html base trees the
# local provider reads as input, so it ships with the repo.
eval/results/
# IDE / editor
.vscode/
.idea/
*.swp
# SWE-bench lazy repo clones (cached checkouts, fetched on demand)
eval/cache/
